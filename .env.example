PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://localhost:27017/cloud_file_manager

# Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# JWT Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production

# Authentication Hashes (Bcrypt hashes generated using node backend/src/utils/hashPassword.js <password>)
# Default user password: user123
NORMAL_USER_PASSWORD_HASH=$2a$10$w8T0Fh0mH7N8N9Q1K2V.veG1QZ4nJ0lJ5K6L7M8N9O0P1Q2R3S4T5
# Default admin password: admin123
ADMIN_PASSWORD_HASH=$2a$10$x9U1Gi1nI8O9O0R2L3W.wfH2RA5oK1mK6L7M8N9O0P1Q2R3S4T5U6

# Storage & Upload Limits
MAX_FILE_SIZE_MB=100
TOTAL_STORAGE_LIMIT_GB=100
